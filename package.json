{
  "name": "red-flag-rush",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "build:server": "node scripts/build-server.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src && node --test server/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "party": "npm run build && npm run build:server && node server/index.mjs",
    "start:party": "node server/index.mjs",
    "test:server": "node --test server/*.test.mjs",
    "test:party": "node scripts/party-browser-check.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "icons:native": "node scripts/generate-native-icons.mjs",
    "mobile:doctor": "node scripts/mobile.mjs doctor",
    "release:check:android": "node scripts/check-release.mjs android",
    "release:check:ios": "node scripts/check-release.mjs ios",
    "mobile:add:android": "node scripts/mobile.mjs add android",
    "mobile:add:ios": "node scripts/mobile.mjs add ios",
    "mobile:sync": "node scripts/mobile.mjs sync",
    "mobile:sync:android": "node scripts/mobile.mjs sync android",
    "mobile:sync:ios": "node scripts/mobile.mjs sync ios",
    "mobile:open:android": "node scripts/mobile.mjs open android",
    "mobile:open:ios": "node scripts/mobile.mjs open ios",
    "mobile:run:android": "node scripts/mobile.mjs run android",
    "mobile:run:ios": "node scripts/mobile.mjs run ios"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "playwright-core": "^1.58.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capgo/native-purchases": "^8.8.1"
  }
}
